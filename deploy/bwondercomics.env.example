# DO NOT COMMIT deploy/bwondercomics.env (it contains secrets)

# Cookie/session signing secret (generate with: openssl rand -hex 32)
APP_SECRET=CHANGE_ME

# Listen on LAN
HOST=0.0.0.0
PORT=8000

# Optional: use a different host port for the FastAPI container (docker compose)
# BWC_API_PORT=8000

# Persist users + comments (writable without sudo)
DATA_ROOT=/srv/bwondercomics/var/bwondercomics

# Safer for LAN: invite-only so nobody else claims the first admin account
REGISTRATION_MODE=invite
INVITE_CODE=CHANGE_ME

# Set true when behind HTTPS (or rely on X-Forwarded-Proto: https from proxy)
COOKIE_SECURE=false

# Ops / maintenance surface
# Keep ADMIN_COMMANDS_ENABLED=false for normal admin diagnostics.
ADMIN_COMMANDS_ENABLED=false
# Backend allowlist for /api/admin/ops* access (comma-separated IP/CIDR entries).
# Leave empty to disable the ops surface entirely.
OPS_ALLOWED_IPS=
# Caddy allowlist for /ops/ (space-separated IP/CIDR entries).
# Keep this in sync with OPS_ALLOWED_IPS using Caddy-compatible formatting.
CADDY_OPS_ALLOWED_IPS=
# Shared bearer token for the host diagnostics timer + ops worker callbacks.
HOST_AUTOMATION_TOKEN=CHANGE_ME

# Analytics (Umami)
# Umami secrets (only required if you run the Umami container in docker compose).
UMAMI_DB_PASSWORD=CHANGE_ME
UMAMI_APP_SECRET=CHANGE_ME
# Optional: expose Umami directly (you can also just use /umami via the main site).
UMAMI_BIND=127.0.0.1
UMAMI_PORT=3000

# After creating a site in Umami, set this to the Website ID.
UMAMI_WEBSITE_ID=
# Serve Umami under the same origin (recommended so admin API calls stay same-origin)
UMAMI_PROXY_PATH=/umami
# Where the backend should connect to Umami:
# - Docker stack: http://umami:3000
# - Host Python:  http://127.0.0.1:3000
UMAMI_UPSTREAM=http://umami:3000
# Optional: override where the tracker is hosted (only needed if not using the proxy path above)
UMAMI_BASE_URL=
# Credentials for the admin analytics summary (Umami API)
# Create a scoped/read-only user in Umami and set the login here.
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
# Alternatively, set a fixed API token instead of a username/password:
# UMAMI_API_TOKEN=

# Database (Postgres)
# Create a password with: openssl rand -hex 24
BWC_DB_NAME=bwondercomics
BWC_DB_USER=bwondercomics
BWC_DB_PASSWORD=CHANGE_ME
# Expose Postgres on localhost only (recommended).
BWC_DB_PORT=5433

# Chat (Stoat/Revolt) public URLs
# Base chat URL (used by frontend "Go to Chat" links and default SSO start target).
CHAT_PUBLIC_URL=https://chat.bwondercomics.com
# API base URL consumed by the Revolt web client bundle.
CHAT_API_PUBLIC_URL=https://chat.bwondercomics.com/api
# Optional override for a dedicated login route in chat.
CHAT_LOGIN_URL=https://chat.bwondercomics.com/login
# Internal Stoat API URL used by backend chat SSO bridge.
CHAT_API_INTERNAL_URL=http://stoat-api:14702
# Internal Stoat events websocket URL used by backend chat websocket proxy.
CHAT_EVENTS_INTERNAL_URL=ws://stoat-events:14703/ws
# Short-lived cookie for chat bootstrap handoff.
CHAT_SSO_COOKIE_NAME=bb_chat_sso
CHAT_SSO_COOKIE_TTL_SECONDS=120
# Friendly device/session label shown in Stoat session list.
CHAT_SSO_DEVICE_NAME=BWonderComics SSO
# Optional override; defaults to APP_SECRET.
CHAT_SSO_PASSWORD_SECRET=CHANGE_ME
# Optional: official server invite code.
# When set, backend SSO auto-joins users to this server.
CHAT_OFFICIAL_INVITE_CODE=

# OIDC provider config (served by this FastAPI app)
# Public issuer URL for discovery/JWKS/token endpoints.
# Discovery URL becomes: https://bwondercomics.com/.well-known/openid-configuration
OIDC_ISSUER=https://bwondercomics.com
# PKCS#8 PEM private key for RS256 signing.
# You can set multi-line PEM by replacing line breaks with \n.
OIDC_SIGNING_KEY_PEM=CHANGE_ME
OIDC_SIGNING_KID=main-2026-02
OIDC_AUTH_CODE_TTL_SECONDS=300
OIDC_ID_TOKEN_TTL_SECONDS=600
OIDC_ACCESS_TOKEN_TTL_SECONDS=600

# Stoat/Revolt OIDC client registration
OIDC_CLIENT_STOAT_ID=stoat
OIDC_CLIENT_STOAT_SECRET=CHANGE_ME
# Comma-separated allowlist. Must exactly match the client's callback URIs.
OIDC_CLIENT_STOAT_REDIRECT_URIS=https://chat.bwondercomics.com/login/callback
OIDC_CLIENT_STOAT_SCOPES=openid,profile,email

# If a user is not signed in when an OIDC authorize request arrives,
# redirect here with ?next=<encoded-url>.
OIDC_LOGIN_PATH=/?openComments=1

# Stoat containers (chat profile in docker compose)
STOAT_API_IMAGE=ghcr.io/revoltchat/server:20250930-2
STOAT_DELTA_IMAGE=ghcr.io/revoltchat/server:20250930-2
STOAT_AUTUMN_IMAGE=ghcr.io/revoltchat/autumn:20250930-2
STOAT_JANUARY_IMAGE=ghcr.io/revoltchat/january:20250930-2
STOAT_LIVEKIT_IMAGE=livekit/livekit-server:v1.7.2
# Pinned digest of the currently deployed legacy web client.
# We pin digest instead of :master to avoid silent frontend changes.
STOAT_WEB_IMAGE=ghcr.io/revoltchat/client@sha256:5cc05853c215a02ee3d1f71390ad00af06c7ef53602b4b21f419f8702607d8c8
STOAT_EVENTS_IMAGE=ghcr.io/revoltchat/bonfire:20250930-2

# Internal container ports used by Caddy for chat.bwondercomics.com proxying.
STOAT_API_INTERNAL_PORT=14702
STOAT_EVENTS_INTERNAL_PORT=14703
STOAT_AUTUMN_INTERNAL_PORT=14704
STOAT_JANUARY_INTERNAL_PORT=14705
STOAT_LIVEKIT_INTERNAL_PORT=7880
STOAT_LIVEKIT_TCP_PORT=7881
STOAT_LIVEKIT_UDP_PORT_RANGE=50000-50100
STOAT_WEB_INTERNAL_PORT=8000

# Chat datastore endpoints for Stoat containers.
STOAT_MONGODB_URI=mongodb://stoat-mongodb:27017/revolt
STOAT_REDIS_URI=redis://stoat-redis:6379

# RabbitMQ bus for Stoat/Revolt backend.
# Keep these aligned with your pinned release/config if it supports custom credentials.
STOAT_RABBITMQ_USER=rabbituser
STOAT_RABBITMQ_PASSWORD=rabbitpass
