# DO NOT COMMIT deploy/bwondercomics.env (it contains secrets)

# Cookie/session signing secret (generate with: openssl rand -hex 32)
APP_SECRET=CHANGE_ME

# Listen on LAN
HOST=0.0.0.0
PORT=8000

# Optional: use a different host port for the FastAPI container (docker compose)
# BWC_API_PORT=8000

# Persist users + comments (writable without sudo)
DATA_ROOT=/srv/bwondercomics/var/bwondercomics

# Safer for LAN: invite-only so nobody else claims the first admin account
REGISTRATION_MODE=invite
INVITE_CODE=CHANGE_ME

# Set true when behind HTTPS (or rely on X-Forwarded-Proto: https from proxy)
COOKIE_SECURE=false

# Analytics (Umami)
# Umami secrets (only required if you run the Umami container in docker compose).
UMAMI_DB_PASSWORD=CHANGE_ME
UMAMI_APP_SECRET=CHANGE_ME
# Optional: expose Umami directly (you can also just use /umami via the main site).
UMAMI_BIND=127.0.0.1
UMAMI_PORT=3000

# After creating a site in Umami, set this to the Website ID.
UMAMI_WEBSITE_ID=
# Serve Umami under the same origin (recommended so admin API calls stay same-origin)
UMAMI_PROXY_PATH=/umami
# Where the backend should connect to Umami:
# - Docker stack: http://umami:3000
# - Host Python:  http://127.0.0.1:3000
UMAMI_UPSTREAM=http://umami:3000
# Optional: override where the tracker is hosted (only needed if not using the proxy path above)
UMAMI_BASE_URL=
# Credentials for the admin analytics summary (Umami API)
# Create a scoped/read-only user in Umami and set the login here.
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
# Alternatively, set a fixed API token instead of a username/password:
# UMAMI_API_TOKEN=

# Database (Postgres)
# Create a password with: openssl rand -hex 24
BWC_DB_NAME=bwondercomics
BWC_DB_USER=bwondercomics
BWC_DB_PASSWORD=CHANGE_ME
# Expose Postgres on localhost only (recommended).
BWC_DB_PORT=5433
