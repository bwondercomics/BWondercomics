[Unit]
Description=BWonderComics API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dbmelville
Group=dbmelville
WorkingDirectory=/srv/bwondercomics
EnvironmentFile=/srv/bwondercomics/deploy/bwondercomics.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/bwondercomics/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

