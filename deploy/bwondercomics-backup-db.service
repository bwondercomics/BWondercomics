[Unit]
Description=BWonderComics validated database backup
After=docker.service
RequiresMountsFor=/mnt/archive

[Service]
Type=exec
User=dbmelville
Group=dbmelville
WorkingDirectory=/srv/bw-quality
Environment=BWC_REPO_ROOT=/srv/bw-quality
Environment=BACKUP_DIR=/mnt/archive/backups/bwondercomics
Environment=BACKUP_STATUS_DIR=/srv/bw-quality/var/diagnostics/backups
Environment=REQUIRE_ARCHIVE_MOUNT=1
Environment=ENV_FILE=/srv/bw-quality/deploy/bwondercomics.env
Environment=COMPOSE_FILE=/srv/bw-quality/deploy/bwondercomics-compose.yml
Environment=BACKUP_LOCK_TIMEOUT_SECONDS=15300
ExecStartPre=/usr/bin/test -x /srv/bw-quality/.backup-venv/bin/python
ExecStart=/usr/bin/env /srv/bw-quality/.backup-venv/bin/python /srv/bw-quality/scripts/backup_artifacts.py database
UMask=0027
TimeoutStartSec=6h30min
Restart=no
RestartSec=15min
RestartForceExitStatus=75
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bwondercomics-backup-db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/archive/backups/bwondercomics /srv/bw-quality/var/diagnostics/backups
