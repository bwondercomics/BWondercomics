[Unit]
Description=LEGACY BWonderComics web server (legacy unit name: battlebros; deprecated)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dbmelville
Group=dbmelville
WorkingDirectory=/srv/bwondercomics
EnvironmentFile=/srv/bwondercomics/deploy/legacy/battlebros.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /srv/bwondercomics/legacy/server.py
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
