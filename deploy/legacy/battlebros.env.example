# LEGACY: prefer deploy/bwondercomics.env.example + deploy/bwondercomics-api.service
# DO NOT COMMIT deploy/battlebros.env (it contains secrets)

# Cookie/session signing secret (generate with: openssl rand -hex 32)
APP_SECRET=CHANGE_ME

# Listen on LAN
HOST=0.0.0.0
PORT=8000

# Persist users + comments (writable without sudo)
DATA_ROOT=/srv/bwondercomics/var/battlebros

# Safer for LAN: invite-only so nobody else claims the first admin account
REGISTRATION_MODE=invite
INVITE_CODE=CHANGE_ME

# Set true when behind HTTPS (or rely on X-Forwarded-Proto: https from proxy)
COOKIE_SECURE=false

# Analytics (Umami)
# After creating a site in Umami, set this to the Website ID.
UMAMI_WEBSITE_ID=
# Optional: override where the tracker is hosted (defaults to http(s)://<host>:UMAMI_PORT)
UMAMI_BASE_URL=
UMAMI_PORT=3000
