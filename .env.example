# Remark42 Configuration
# DO NOT COMMIT THIS FILE TO GIT!

# App secret for signing built-in auth sessions (generate with: openssl rand -hex 32)
APP_SECRET=CHANGE_THIS_TO_RANDOM_STRING

# Random secret key for Remark42 (legacy, if you keep using it)
REMARK_SECRET=CHANGE_THIS_TO_RANDOM_STRING

# Google OAuth Credentials (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Admin email (your Google account email for moderation access)
ADMIN_EMAIL=your-email@gmail.com

# Remark42 URL
# For local testing: http://localhost:8080
# For production: https://comments.bwondercomics.com (or your domain)
REMARK_URL=http://localhost:8080
