  "htmlSamples": [
    {
      "name": "text formatting passes through",
      "mode": "text",
      "input": "<p>Hello <strong>world</strong> and <em>friends</em></p>",
      "expected": "<p>Hello <strong>world</strong> and <em>friends</em></p>"
    },
    {
      "name": "script tag and contents dropped",
      "mode": "text",
      "input": "<p>Hi</p><script>alert(1)</script>",
      "expected": "<p>Hi</p>"
    },
    {
      "name": "style tag and contents dropped",
      "mode": "text",
      "input": "<p>Before</p><style>p { color: red }</style><p>After</p>",
      "expected": "<p>Before</p><p>After</p>"
    },
    {
      "name": "disallowed inline tag unwraps to its text",
      "mode": "text",
      "input": "<p>a <span>b</span> c</p>",
      "expected": "<p>a b c</p>"
    },
    {
      "name": "event handler attributes stripped",
      "mode": "text",
      "input": "<a href=\"/comics.html\" onclick=\"steal()\">Read</a>",
      "expected": "<a href=\"/comics.html\">Read</a>"
    },
    {
      "name": "javascript URL neutralized",
      "mode": "text",
      "input": "<a href=\"javascript:alert(1)\">x</a>",
      "expected": "<a>x</a>"
    },
    {
      "name": "style attribute stripped, data attribute kept",
      "mode": "text",
      "input": "<p style=\"color:red\" data-note=\"ok\">x</p>",
      "expected": "<p data-note=\"ok\">x</p>"
    },
    {
      "name": "list structure preserved",
      "mode": "text",
      "input": "<ul><li>one</li><li>two</li></ul>",
      "expected": "<ul><li>one</li><li>two</li></ul>"
    },
    {
      "name": "anchor href kept with class sanitized",
      "mode": "text",
      "input": "<a href=\"https://example.com/page\" class=\"pb x!! y\">go</a>",
      "expected": "<a href=\"https://example.com/page\" class=\"pb x y\">go</a>"
    },
    {
      "name": "div unwraps in text mode",
      "mode": "text",
      "input": "<div>plain</div>",
      "expected": "plain"
    },
    {
      "name": "div allowed in html mode",
      "mode": "html",
      "input": "<div class=\"wrap\"><span>inner</span></div>",
      "expected": "<div class=\"wrap\"><span>inner</span></div>"
    },
    {
      "name": "img kept with sanitized src in html mode",
      "mode": "html",
      "input": "<img src=\"/uploads/x.png\" alt=\"Cover\">",
      "expected": "<img src=\"/uploads/x.png\" alt=\"Cover\">"
    },
    {
      "name": "img javascript src dropped in html mode",
      "mode": "html",
      "input": "<img src=\"javascript:alert(1)\" alt=\"x\">",
      "expected": "<img alt=\"x\">"
    },
    {
      "name": "iframe dropped entirely in html mode",
      "mode": "html",
      "input": "<div>ok</div><iframe src=\"https://evil.invalid\"></iframe>",
      "expected": "<div>ok</div>"
    },
    {
      "name": "protocol-relative href dropped",
      "mode": "text",
      "input": "<a href=\"//evil.invalid/x\">x</a>",
      "expected": "<a>x</a>"
    },
    {
      "name": "unclosed tag auto-closed",
      "mode": "text",
      "input": "<p>open",
      "expected": "<p>open</p>"
    },
    {
      "name": "heading levels gated by mode",
      "mode": "text",
      "input": "<h1>big</h1><h2>ok</h2>",
      "expected": "big<h2>ok</h2>"
    }
  ],
