{
    "name": "battle-bros-reader",
    "version": "1.0.0",
    "description": "Battle Bros comic reader",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node ./node_modules/vitest/vitest.mjs run",
        "test:watch": "node ./node_modules/vitest/vitest.mjs",
        "test:ui": "node ./node_modules/vitest/vitest.mjs --ui",
        "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
        "lint": "eslint reader/ admin/",
        "lint:fix": "eslint --fix reader/ admin/",
        "format": "prettier --write '**/*.{js,html,css,md}'",
        "format:check": "prettier --check '**/*.{js,html,css,md}'"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@vitest/ui": "^1.0.4",
        "eslint": "^9.39.2",
        "happy-dom": "^12.10.3",
        "prettier": "^3.7.4",
        "terser": "^5.44.1",
        "vite": "^5.4.11",
        "vitest": "^1.0.4"
    },
    "keywords": [
        "comic",
        "reader",
        "webcomic"
    ],
    "author": "Battle Bros Comics",
    "license": "MIT"
}
