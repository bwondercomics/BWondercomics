{
    "name": "battle-bros-reader",
    "version": "1.0.0",
    "description": "Battle Bros comic reader",
    "type": "module",
    "scripts": {
        "dev": "node ./node_modules/vite/bin/vite.js",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node ./node_modules/vitest/vitest.mjs run",
        "test:watch": "node ./node_modules/vitest/vitest.mjs",
        "test:ui": "node ./node_modules/vitest/vitest.mjs --ui",
        "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
        "lint": "eslint reader/ admin/",
        "lint:fix": "eslint --fix reader/ admin/",
        "lint:py": "python3 -m ruff check backend/app backend/alembic",
        "format": "prettier --write '**/*.{js,html,css,md}'",
        "format:check": "prettier --check '**/*.{js,html,css,md}'",
        "format:py": "python3 -m ruff format backend/app backend/alembic",
        "format:py:check": "python3 -m ruff format --check backend/app backend/alembic"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@vitest/ui": "^1.0.4",
        "eslint": "^9.39.2",
        "happy-dom": "^12.10.3",
        "prettier": "^3.7.4",
        "terser": "^5.44.1",
        "vite": "^5.4.11",
        "vitest": "^1.0.4"
    },
    "keywords": [
        "comic",
        "reader",
        "webcomic"
    ],
    "author": "Battle Bros Comics",
    "license": "MIT"
}
